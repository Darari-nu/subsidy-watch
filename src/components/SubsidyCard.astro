---
import {
  areaChips,
  daysBetween,
  formatAmount,
  formatDate,
  getSummary,
  searchText,
  type Subsidy
} from "../lib/subsidy";

interface Props {
  subsidy: Subsidy;
  today: string;
}

const { subsidy, today } = Astro.props;
const base = import.meta.env.BASE_URL;
const summary = getSummary(subsidy.id);
const daysLeft = subsidy.end ? Math.max(0, daysBetween(today, subsidy.end)) : null;
const sinceFirstSeen = daysBetween(subsidy.first_seen, today);
const isNew = sinceFirstSeen >= 0 && sinceFirstSeen <= 7;
const isClosing = subsidy.status === "closing_soon";
const { chips, more, national, all } = areaChips(subsidy.areas);
const detailUrl = `${base}s/${subsidy.id}/`;
---

<article
  class:list={[
    "subsidy-card border-t bg-transparent py-7 sm:py-9",
    isClosing ? "border-vermilion" : "border-ink/20"
  ]}
  data-areas={subsidy.areas.join("|")}
  data-employees={subsidy.employees}
  data-amount={subsidy.max_limit ?? ""}
  data-end={subsidy.end}
  data-first-seen={subsidy.first_seen}
  data-id={subsidy.id}
  data-text={searchText(subsidy, summary)}
>
  <div class="grid gap-5 sm:grid-cols-[9.5rem_1fr] sm:gap-10">
    <div class="flex items-baseline gap-3 sm:block">
      <p class="flex items-center gap-1.5 text-xs text-muted sm:mb-1">
        <img src={`${base}icons/deadline.png`} alt="" width="16" height="16" class="size-4" />
        {daysLeft === null ? "締切" : "締切まで"}
      </p>
      <p
        class:list={[
          "font-display leading-none font-bold",
          isClosing ? "text-vermilion" : "text-ink"
        ]}
        aria-label={daysLeft === null ? "締切は本文参照" : daysLeft === 0 ? "本日締切" : `締切まであと${daysLeft}日`}
      >
        {
          daysLeft === null ? (
            <span class="text-base">本文参照</span>
          ) : daysLeft === 0 ? (
            <span class="text-3xl sm:text-4xl">本日</span>
          ) : (
            <>
              <span class="text-5xl tabular-nums sm:text-6xl">{daysLeft}</span>
              <span class="ml-1 text-base">日</span>
            </>
          )
        }
      </p>
      {subsidy.end && <p class="text-xs text-muted sm:mt-3">{formatDate(subsidy.end)}</p>}
      {
        (isClosing || isNew) && (
          <p class="hidden gap-2 sm:mt-3 sm:flex">
            {isClosing && (
              <span class="border border-vermilion px-2 text-[0.7rem] font-medium text-vermilion-text">
                締切間近
              </span>
            )}
            {isNew && (
              <span class="inline-flex items-center gap-1 bg-accent px-2 text-[0.7rem] font-medium text-white">
                NEW
              </span>
            )}
          </p>
        )
      }
    </div>

    <div class="min-w-0">
      <div class="mb-2 flex flex-wrap items-center gap-1.5 sm:hidden">
        {isClosing && (
          <span class="border border-vermilion px-2 text-[0.7rem] font-medium text-vermilion-text">
            締切間近
          </span>
        )}
        {isNew && (
          <span class="bg-accent px-2 text-[0.7rem] font-medium text-white">NEW</span>
        )}
      </div>

      <h2 class="font-display text-lg leading-relaxed font-bold sm:text-xl">
        <a href={detailUrl} class="text-ink no-underline hover:text-accent hover:underline">
          {subsidy.title}
        </a>
      </h2>

      <ul class="mt-3 flex flex-wrap items-center gap-1.5" aria-label="対象地域">
        <li class="mr-0.5 flex items-center">
          <img src={`${base}icons/area.png`} alt="" width="16" height="16" class="size-4" />
        </li>
        {
          chips.map((chip) => (
            <li class:list={["chip", national && "chip-national"]}>{chip}</li>
          ))
        }
        {more > 0 && (
          <li class="chip" title={all.join("、")}>
            +{more}
          </li>
        )}
        {subsidy.municipality && <li class="chip">{subsidy.municipality}</li>}
        <li class="chip">{subsidy.employees}</li>
      </ul>

      <dl class="mt-5 flex flex-wrap items-baseline gap-x-8 gap-y-2">
        <div>
          <dt class="flex items-center gap-1.5 text-xs text-muted">
            <img src={`${base}icons/amount.png`} alt="" width="16" height="16" class="size-4" />
            補助上限
          </dt>
          <dd class="font-display text-2xl font-bold text-accent">
            {formatAmount(subsidy.max_limit)}
          </dd>
        </div>
      </dl>

      {
        summary && (
          <details class="summary-block mt-3 border-t border-line pt-1">
            <summary>
              AI要約
              <span class="text-xs font-normal text-muted">（自動生成・要確認）</span>
            </summary>
            <dl class="grid gap-x-5 gap-y-2 pb-2 text-sm leading-7 sm:grid-cols-[5.5rem_1fr]">
              <dt class="text-xs text-muted sm:pt-0.5">対象者</dt>
              <dd>{summary.who}</dd>
              <dt class="text-xs text-muted sm:pt-0.5">使い道</dt>
              <dd>{summary.what}</dd>
              <dt class="text-xs text-muted sm:pt-0.5">金額</dt>
              <dd>{summary.amount}</dd>
              <dt class="text-xs text-muted sm:pt-0.5">注意点</dt>
              <dd>{summary.note}</dd>
            </dl>
          </details>
        )
      }

      <div class="mt-4 flex flex-wrap gap-2">
        <a
          class="link-button link-primary"
          href={subsidy.source === "jnet21" ? subsidy.source_url : subsidy.jgrants_url}
          target="_blank"
          rel="noopener noreferrer"
        >
          {subsidy.source === "jnet21" ? "J-Net21で確認" : "jGrantsで確認"}
        </a>
        {
          subsidy.official_url && (
            <a
              class="link-button link-secondary"
              href={subsidy.official_url}
              target="_blank"
              rel="noopener noreferrer"
            >
              公式ページ
            </a>
          )
        }
      </div>
      {subsidy.source === "jnet21" && <p class="mt-2 text-xs text-muted">出典：J-Net21 支援情報</p>}
    </div>
  </div>
</article>
