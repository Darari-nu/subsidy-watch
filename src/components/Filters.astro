---
import { PREFECTURES } from "../lib/subsidy";

interface Props {
  employees: string[];
}

const { employees } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<div class="sticky top-0 z-20 border-b border-line bg-paper/95 backdrop-blur" id="search-bar">
  <form
    role="search"
    aria-label="補助金を検索"
    class="container-page py-3"
    onsubmit="return false"
  >
    <div class="grid grid-cols-[1fr_auto] gap-2 sm:gap-4">
      <label class="relative block">
        <span class="sr-only">キーワードで検索（制度名・地域・要約など）</span>
        <img
          src={`${base}icons/search.png`}
          alt=""
          width="20"
          height="20"
          class="pointer-events-none absolute top-1/2 left-3 size-5 -translate-y-1/2"
        />
        <input
          id="filter-keyword"
          class="filter-control !min-h-12 !pl-11 !text-base"
          type="search"
          placeholder="キーワード　例：省エネ、設備投資"
          autocomplete="off"
          enterkeyhint="search"
        />
      </label>
      <label class="filter-label sm:grid-flow-col sm:items-center sm:gap-3">
        <span class="sr-only sm:not-sr-only sm:whitespace-nowrap">並び替え</span>
        <select id="filter-sort" class="filter-control !min-h-12 w-32 sm:w-44" aria-label="並び替え">
          <option value="deadline">締切が近い順</option>
          <option value="new">新着順</option>
          <option value="amount">金額（上限）順</option>
        </select>
      </label>
    </div>
  </form>
</div>

<section class="container-page pt-5 pb-2" aria-label="絞り込み">
  <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-[1.2fr_1fr_1fr_auto] lg:items-end">
    <div class="grid gap-1.5">
      <label class="filter-label" for="filter-region">
        地域
      </label>
      <select id="filter-region" class="filter-control">
        <option value="">すべての地域</option>
        <option value="__national">全国のみ</option>
        {PREFECTURES.map((name: string) => <option value={name}>{name}</option>)}
      </select>
    </div>
    <label class="filter-label">
      従業員規模
      <select id="filter-employees" class="filter-control">
        <option value="">すべての規模</option>
        {employees.map((employee) => <option value={employee}>{employee}</option>)}
      </select>
    </label>
    <label class="filter-label">
      上限金額
      <select id="filter-amount" class="filter-control">
        <option value="">すべての金額</option>
        <option value="under-1m">100万円未満</option>
        <option value="1m-5m">100万〜500万円未満</option>
        <option value="5m-10m">500万〜1,000万円未満</option>
        <option value="over-10m">1,000万円以上</option>
        <option value="unknown">金額未掲載</option>
      </select>
    </label>
    <button
      id="filter-reset"
      type="button"
      class="min-h-11 border border-line bg-transparent px-4 text-sm text-muted hover:border-accent hover:text-accent"
    >
      条件をクリア
    </button>
  </div>
  <label
    id="national-toggle-wrap"
    class="mt-3 inline-flex min-h-11 cursor-pointer items-center gap-2 text-sm text-ink"
    hidden
  >
    <input id="filter-national" type="checkbox" checked class="size-4 accent-[#1F5C4A]" />
    <span>全国対象の制度も含める<span class="text-muted">（<span class="chip chip-national">全国</span>のチップで区別）</span></span>
  </label>
</section>
