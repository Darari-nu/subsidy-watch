---
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";
import {
  areaChips,
  daysBetween,
  formatAmount,
  formatDate,
  getActiveSubsidies,
  getSummary,
  todayInJapan,
  type Subsidy
} from "../../lib/subsidy";

export function getStaticPaths() {
  return getActiveSubsidies().map((subsidy) => ({
    params: { id: subsidy.id },
    props: { subsidy }
  }));
}

interface Props {
  subsidy: Subsidy;
}

const { subsidy } = Astro.props;
const base = import.meta.env.BASE_URL;
const summary = getSummary(subsidy.id);
const daysLeft = Math.max(0, daysBetween(todayInJapan(), subsidy.end));
const { chips, more, national, all } = areaChips(subsidy.areas, 99);
const description = summary
  ? `${summary.who}／${summary.what}`.slice(0, 120)
  : `締切 ${subsidy.end}・上限 ${formatAmount(subsidy.max_limit)}・${subsidy.areas.join("、")}`;
---

<Layout title={`${subsidy.title} | 補助金ウォッチ`} description={description}>
  <!-- この詳細ページが Pagefind の検索対象（一覧ページ側は data-pagefind-ignore） -->
  <article
    class="container-page max-w-3xl py-10 sm:py-16"
    data-pagefind-body
    data-pagefind-meta={`sid[data-sid]`}
    data-sid={subsidy.id}
  >
    <p class="mb-6 text-sm"><a href={base} class="text-accent">← 一覧へ戻る</a></p>
    <p class="eyebrow">締切 {formatDate(subsidy.end)}・あと{daysLeft}日</p>
    <h1 class="font-display mt-4 text-2xl leading-relaxed font-bold sm:text-3xl">
      {subsidy.title}
    </h1>

    <ul class="mt-5 flex flex-wrap gap-1.5" aria-label="対象地域">
      {chips.map((chip) => <li class:list={["chip", national && "chip-national"]}>{chip}</li>)}
      {more > 0 && <li class="chip">+{more}</li>}
      <li class="chip">{subsidy.employees}</li>
    </ul>
    <p class="sr-only">対象地域: {all.join("、")}</p>

    <dl class="mt-8 grid gap-6 border-y border-line py-6 sm:grid-cols-2">
      <div>
        <dt class="text-xs text-muted">補助上限</dt>
        <dd class="font-display text-3xl font-bold text-accent">
          {formatAmount(subsidy.max_limit)}
        </dd>
      </div>
      <div>
        <dt class="text-xs text-muted">受付期間</dt>
        <dd>
          {subsidy.start ? formatDate(subsidy.start) : "本文参照"} 〜 {formatDate(subsidy.end)}
        </dd>
      </div>
    </dl>

    {subsidy.catch && <p class="mt-6 leading-8">{subsidy.catch}</p>}

    {
      summary && (
        <section class="mt-8" aria-labelledby="ai-summary">
          <h2 id="ai-summary" class="font-display text-lg font-bold">
            AI要約<span class="ml-2 text-xs font-normal text-muted">（自動生成・要確認）</span>
          </h2>
          <dl class="mt-3 grid gap-x-6 gap-y-3 text-sm leading-7 sm:grid-cols-[6rem_1fr]">
            <dt class="text-xs text-muted sm:pt-0.5">対象者</dt>
            <dd>{summary.who}</dd>
            <dt class="text-xs text-muted sm:pt-0.5">使い道</dt>
            <dd>{summary.what}</dd>
            <dt class="text-xs text-muted sm:pt-0.5">金額</dt>
            <dd>{summary.amount}</dd>
            <dt class="text-xs text-muted sm:pt-0.5">注意点</dt>
            <dd>{summary.note}</dd>
          </dl>
        </section>
      )
    }

    <div class="mt-8 flex flex-wrap gap-2" data-pagefind-ignore>
      <a class="link-button link-primary" href={subsidy.jgrants_url} target="_blank" rel="noopener noreferrer">
        jGrantsで確認
      </a>
      {
        subsidy.official_url && (
          <a class="link-button link-secondary" href={subsidy.official_url} target="_blank" rel="noopener noreferrer">
            公式ページ
          </a>
        )
      }
    </div>
    <p class="mt-8 text-xs leading-6 text-muted" data-pagefind-ignore>
      申請前に必ずjGrantsおよび公式ページで最新の公募要領をご確認ください。AI要約は自動生成のため誤りを含む可能性があります。
    </p>
  </article>
  <Footer />
</Layout>
