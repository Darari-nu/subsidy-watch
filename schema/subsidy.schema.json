{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://subsidy-watch.local/schema/subsidy.schema.json",
  "title": "補助金ウォッチ正規化データ",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "title",
      "max_limit",
      "area",
      "areas",
      "employees",
      "start",
      "end",
      "status",
      "source",
      "official_url",
      "catch",
      "first_seen"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "max_limit": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 0
      },
      "area": {
        "type": "string",
        "minLength": 1
      },
      "areas": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "enum": [
            "全国",
            "北海道",
            "青森県",
            "岩手県",
            "宮城県",
            "秋田県",
            "山形県",
            "福島県",
            "茨城県",
            "栃木県",
            "群馬県",
            "埼玉県",
            "千葉県",
            "東京都",
            "神奈川県",
            "新潟県",
            "富山県",
            "石川県",
            "福井県",
            "山梨県",
            "長野県",
            "岐阜県",
            "静岡県",
            "愛知県",
            "三重県",
            "滋賀県",
            "京都府",
            "大阪府",
            "兵庫県",
            "奈良県",
            "和歌山県",
            "鳥取県",
            "島根県",
            "岡山県",
            "広島県",
            "山口県",
            "徳島県",
            "香川県",
            "愛媛県",
            "高知県",
            "福岡県",
            "佐賀県",
            "長崎県",
            "熊本県",
            "大分県",
            "宮崎県",
            "鹿児島県",
            "沖縄県"
          ]
        },
        "description": "正規化済み対象地域。都道府県名（JIS順）または [\"全国\"]"
      },
      "area_flags": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        },
        "description": "正規化時の注意（title_prefix_override / invalid_area:値 など）"
      },
      "employees": {
        "type": "string",
        "minLength": 1
      },
      "start": {
        "type": [
          "string",
          "null"
        ],
        "format": "date"
      },
      "end": {
        "type": ["string", "null"],
        "format": "date"
      },
      "status": {
        "enum": [
          "new",
          "closing_soon",
          "open"
        ]
      },
      "source": {
        "enum": ["jgrants", "jnet21"]
      },
      "source_url": { "type": "string", "format": "uri" },
      "municipality": { "type": ["string", "null"] },
      "jgrants_url": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://www\\.jgrants-portal\\.go\\.jp/subsidy/"
      },
      "official_url": {
        "type": [
          "string",
          "null"
        ],
        "format": "uri"
      },
      "catch": {
        "type": "string"
      },
      "first_seen": {
        "type": "string",
        "format": "date"
      }
    },
    "oneOf": [
      { "properties": { "source": { "const": "jgrants" }, "jgrants_url": { "type": "string" } }, "required": ["jgrants_url"] },
      { "properties": { "source": { "const": "jnet21" }, "source_url": { "type": "string" } }, "required": ["source_url"] }
    ]
  }
}
