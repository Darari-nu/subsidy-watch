{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://subsidy-watch.local/schema/sources.schema.json",
  "type": "object",
  "$defs": {
    "areaList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "全国",
          "北海道",
          "青森県",
          "岩手県",
          "宮城県",
          "秋田県",
          "山形県",
          "福島県",
          "茨城県",
          "栃木県",
          "群馬県",
          "埼玉県",
          "千葉県",
          "東京都",
          "神奈川県",
          "新潟県",
          "富山県",
          "石川県",
          "福井県",
          "山梨県",
          "長野県",
          "岐阜県",
          "静岡県",
          "愛知県",
          "三重県",
          "滋賀県",
          "京都府",
          "大阪府",
          "兵庫県",
          "奈良県",
          "和歌山県",
          "鳥取県",
          "島根県",
          "岡山県",
          "広島県",
          "山口県",
          "徳島県",
          "香川県",
          "愛媛県",
          "高知県",
          "福岡県",
          "佐賀県",
          "長崎県",
          "熊本県",
          "大分県",
          "宮崎県",
          "鹿児島県",
          "沖縄県"
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "version",
    "sources"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "screening": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include_areas": {
          "$ref": "#/$defs/areaList"
        },
        "exclude_areas": {
          "$ref": "#/$defs/areaList"
        },
        "national_threshold": {
          "type": "integer",
          "minimum": 2,
          "maximum": 47
        },
        "title_prefix_wins": {
          "type": "boolean"
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "enabled",
              "name",
              "base_url",
              "public_base_url",
              "keywords"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "const": "api"
              },
              "enabled": {
                "type": "boolean"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "base_url": {
                "type": "string",
                "format": "uri"
              },
              "public_base_url": {
                "type": "string",
                "format": "uri"
              },
              "keywords": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "enabled",
              "name",
              "url",
              "include_keywords"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "const": "rss"
              },
              "enabled": {
                "type": "boolean"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "include_keywords": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    }
  }
}
